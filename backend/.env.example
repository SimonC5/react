# Backend FastAPI. Copia este archivo como backend/.env (está ignorado por git).

# Base de datos. Con DB_ENGINE=sqlite (el valor por defecto) se usa
# backend/data/simonsc.db y no hay nada que instalar. Con DB_ENGINE=mysql se
# usa el MySQL de XAMPP: arranca MySQL en el panel de XAMPP antes de la API.
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=simonsc
DB_USER=root
DB_PASSWORD=
# Alternativa de una sola línea, útil en el despliegue:
# DATABASE_URL=mysql://usuario:clave@host:3306/simonsc

# Autenticación
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=2h

# CORS: dominio del Frontend desplegado, separado por comas si hay varios.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# Chatbot con Inteligencia Artificial.
# NUNCA subas esta clave al repositorio: el archivo .env está en .gitignore.
IA_API_KEY=
IA_API_URL=https://api.openai.com/v1/chat/completions
IA_MODEL=gpt-4o-mini
IA_TIMEOUT=20

# Correo para la recuperación de contraseña.
# Si SMTP_HOST queda vacío, el enlace se imprime en la consola del backend
# en lugar de enviarse por correo, que es suficiente para desarrollo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
