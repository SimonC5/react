# Backend FastAPI. Copia este archivo como backend/.env (está ignorado por git).

# Base de datos. Con DB_ENGINE=sqlite (el valor por defecto) se usa
# backend/data/simonsc.db y no hay nada que instalar. Con DB_ENGINE=mysql se
# usa el MySQL de XAMPP: arranca MySQL en el panel de XAMPP antes de la API.
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=simonsc
DB_USER=root
DB_PASSWORD=
# Alternativa de una sola línea, útil en el despliegue:
# DATABASE_URL=mysql://usuario:clave@host:3306/simonsc

# Autenticación
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=2h

# CORS: dominio del Frontend desplegado, separado por comas si hay varios.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# Chatbot con Inteligencia Artificial.
# NUNCA subas esta clave al repositorio: el archivo .env está en .gitignore.
IA_API_KEY=
# Dirección del proveedor. La de abajo es la de Google AI Studio, que da clave
# gratis en https://aistudio.google.com/apikey. Sirve cualquier proveedor con
# endpoint estilo OpenAI (OpenAI, Groq, etc.).
IA_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Varios modelos separados por coma: si el primero está saturado, no existe para
# tu clave o tarda de más, se intenta con el siguiente. Deja la lista completa;
# escribir uno solo hace que una saturación pasajera deje al chatbot sin IA.
IA_MODEL=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.8-flash
# Segundos de espera por modelo. Menos de 30 corta a los modelos cargados antes
# de que alcancen a escribir la primera palabra.
IA_TIMEOUT=30
# Segundos como máximo probando modelos, para no dejar al cliente esperando.
IA_PRESUPUESTO=55
# Vueltas completas a la lista de modelos. Google avisa que la saturación es
# pasajera, así que con 2 una racha corta de 503 ya no deja sin respuesta.
IA_VUELTAS=2
# Segundos de espera antes de la segunda vuelta.
IA_ESPERA_ENTRE_VUELTAS=2

# Correo para la recuperación de contraseña y para enviarle al cliente la
# respuesta de su PQR. Hay dos formas y el programa usa la que esté configurada.
#
# FORMA 1 (recomendada, y la única que sirve en el plan gratuito de Render,
# que bloquea la salida a los puertos de SMTP): una API web. La cuenta gratuita
# de Brevo (https://www.brevo.com) da 300 correos al día y verifica el remitente
# con un solo correo, sin necesidad de tener un dominio propio. La clave se saca
# en SMTP & API > API Keys. NUNCA la subas al repositorio.
EMAIL_API_KEY=
# Correo verificado en el proveedor, el que aparece como remitente.
EMAIL_FROM=
# Solo si se usa otro proveedor con el mismo formato de petición.
EMAIL_API_URL=https://api.brevo.com/v3/smtp/email

# FORMA 2: SMTP. Sirve en tu propio computador y en los planes de pago.
# Con Gmail basta llenar estas dos líneas: el servidor y el puerto se deducen
# del dominio del correo. SMTP_PASSWORD NO es la contraseña de la cuenta, es una
# contraseña de aplicación de 16 letras que se crea en
# https://myaccount.google.com/apppasswords (hay que tener activada la
# verificación en dos pasos). NUNCA subas esta clave al repositorio: este
# archivo está en .gitignore.
SMTP_USER=
SMTP_PASSWORD=
# Si no se configura ninguna de las dos formas no se envía nada: el enlace se
# imprime en la consola del backend, que es suficiente para desarrollo.

# Opcionales. Solo hacen falta con un proveedor que no sea de los conocidos
# (Gmail, Outlook, Yahoo) o si el proveedor usa otro puerto.
SMTP_HOST=
SMTP_PORT=
# Remitente visible. Si queda vacío se usa SMTP_USER, que es lo que exige Gmail.
SMTP_FROM=
# STARTTLS (puerto 587). En el puerto 465 se usa TLS directo automáticamente.
SMTP_USE_TLS=true

