    {
      "name": "Ventas",
      "item": [
        {
          "name": "Registrar venta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ventas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Laura Gómez\",\n  \"clienteDocumento\": \"1024567890\",\n  \"observaciones\": \"Venta desde el sitio web\",\n  \"items\": [\n    {\n      \"tipo\": \"producto\",\n      \"itemId\": 1,\n      \"cantidad\": 2,\n      \"descuento\": 0\n    },\n    {\n      \"tipo\": \"servicio\",\n      \"itemId\": 1,\n      \"cantidad\": 1,\n      \"descuento\": 50000\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Historial de ventas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/ventas"
          }
        },
        {
          "name": "Historial filtrado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/ventas?fechaInicio=2026-01-01&estado=Pagada&cliente=Laura"
          }
        },
        {
          "name": "Detalle de una venta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/ventas/{{ventaId}}"
          }
