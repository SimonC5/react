{
  "info": {
    "name": "SimonC API - Quinto avance FastAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "resourceId",
      "value": "1"
    },
    {
      "key": "ventaId",
      "value": "1"
    },
    {
      "key": "facturaId",
      "value": "1"
    },
    {
      "key": "pqrId",
      "value": "1"
    },
    {
      "key": "fecha",
      "value": ""
    },
    {
      "key": "conversacionId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Registrar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana\",\n  \"lastName\": \"Prueba\",\n  \"documentType\": \"CC\",\n  \"documentNumber\": \"12345678\",\n  \"address\": \"Calle 10 #20-30\",\n  \"phone\": \"3001234567\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"Ana12345\"\n}"
        },
        "url": "{{baseUrl}}/usuarios/registro"
      }
    },
    {
      "name": "Login JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@simonsc.com\",\n  \"password\": \"Admin1234\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Usuarios protegidos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/users"
      }
    },
    {
      "name": "Productos GET",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Productos POST",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Producto demo\",\"description\":\"Prueba\",\"price\":100000}"
        },
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Productos PUT",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Producto actualizado\",\"description\":\"Edición\",\"price\":120000}"
        },
        "url": "{{baseUrl}}/products/{{resourceId}}"
      }
    },
    {
      "name": "Productos PATCH estado",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"active\":false}"
        },
        "url": "{{baseUrl}}/products/{{resourceId}}/status"
      }
    },
    {
      "name": "Productos DELETE",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/products/{{resourceId}}"
      }
