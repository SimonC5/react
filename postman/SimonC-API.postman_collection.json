            "url": "{{baseUrl}}/pqr",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"Queja\",\n  \"asunto\": \"Demora en la entrega\",\n  \"descripcion\": \"El pedido llegó dos días después de lo acordado.\"\n}"
            }
