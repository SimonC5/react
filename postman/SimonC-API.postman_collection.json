          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"active\":false}"
        },
        "url": "{{baseUrl}}/services/{{resourceId}}/status"
